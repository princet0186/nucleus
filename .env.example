MASTER_KEY="your-secure-encryption-key-here"

# Primary Gemini API key
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: add as many extra keys as you can collect to dodge free-tier rate
# limits. The key manager round-robins across all of them and rotates on 429.
# GEMINI_API_KEY_1="AIza..."
# GEMINI_API_KEY_2="AIza..."
# GEMINI_API_KEY_3="AIza..."

# Optional: override model routing (intent -> real Gemini model id)
# GEMINI_GENERAL_MODEL="gemini-2.5-flash"
# GEMINI_PLANNING_MODEL="gemini-2.5-pro"

# Privacy / egress boundary
# SANITIZE_EGRESS=false   # ONLY to demo the unprotected baseline
# EGRESS_DEBUG=true       # print the exact outbound prompt for auditing

# MEDEVAC consensus voting (PATE-style reliability, samples per 9-line)
# MEDEVAC_CONSENSUS_SAMPLES=3

# TLS 1.3 (generate a local cert with: mkcert localhost)
# SSL_CERTFILE="./certs/localhost.pem"
# SSL_KEYFILE="./certs/localhost-key.pem"

# --- Offline maps (see docs/maps.md) ----------------------------------------
# Build a region first:  ./tools/build_region.sh kashmir india
# TILES_DIR="./data/tiles"
# FONTS_DIR="./data/tiles/fonts"     # glyph PBFs; without them the map is unlabelled

# Leave empty to auto-select when exactly one region is installed.
# MAPS_DEFAULT_REGION="kashmir"

# MAPS_SEARCH_RADIUS_KM=25
# MAPS_MAX_SEARCH_RADIUS_KM=200
# MAPS_MAX_RESULTS=10
# MAPS_USER_POI_LIMIT=5000

# "straight_line" needs no service and reports no ETA (none can be computed
# without a road network). Swap for valhalla/osrm in the live-tracking phase.
# MAPS_ROUTING_PROVIDER="straight_line"

# false = map answers come from a deterministic local template with ZERO egress.
# true  = Gemini phrases the answer from a tokenized fact sheet; it never sees a
#         real coordinate or facility name.
# MAPS_AI_PROSE=true

# Default basemap look: "day" (light street map) or "night" (dark tactical).
# The frontend has a per-device toggle; this is the server-side fallback.
# MAPS_STYLE_THEME=day

# Deadline on the cloud phrasing step. A degraded link blackholes packets rather
# than refusing them; without this the request hangs and the operator never gets
# the local answer that was ready in milliseconds.
# MAPS_AI_TIMEOUT_S=8.0
