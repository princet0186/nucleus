# Database & Encrypted Logs
data/db/*.db
data/db/*.enc
*.db
*.enc
*.sqlite
*.sqlite3

# Offline map artifacts. All are rebuildable from OpenStreetMap via
# tools/build_region.sh, and all are far too large to version:
#   .mbtiles       vector tiles       (100s of MB to GBs per region)
#   data/sources/  OSM extracts       (GBs)
#   planetiler.jar the build tool     (~100 MB)
#   fonts/         glyph PBFs
*.mbtiles
data/tiles/
data/sources/
tools/planetiler.jar

# Node & Frontend Build
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Python cache & compiled code
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db

# IDE & Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Ignore project proposals and workspace checks
*Proposal*.md
WORKSPACE_CHECK.md
